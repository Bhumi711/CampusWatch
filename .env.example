# Copy to .env (repo root) — every value is optional; defaults shown.
# Never commit .env. SNMP credentials are entered in the UI and stored only in the local SQLite DB.

# SQLite file (default: backend/data/campus.db). Relative paths are relative to where uvicorn is started.
# DATABASE_URL=sqlite:///./data/campus.db

# Initial runtime settings (after first start, changes made in the UI are persisted in the DB and win).
COLLECTION_MODE=demo
POLL_INTERVAL_SECONDS=10

# Demo generator: seeded once on startup if no demo data exists.
DEMO_AUTO_SEED=true
DEMO_SEED=42
DEMO_HISTORY_HOURS=24

# SNMP polling
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1

# Allowed browser origins (the Vite dev server proxies /api, so this is only needed for direct access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set false to run the API without the background poller
COLLECTOR_ENABLED=true
